# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ── Compiled hot-path extensions (regenerated by setup_cython.py) ─────────────
src/fast/scan.c
src/fast/*.so
*.so

# ── Rust build output ────────────────────────────────────────────────────────
rust_ws_client/target/

# ── Secrets & local environment ──────────────────────────────────────────────
.env
.env.local
*.key
*.pem

# ── Runtime data, locks & logs ───────────────────────────────────────────────
data/
logs/
*.sqlite
.book_snapshot.json
live_trading.lock

# ── Generated reports & audit output (keep the directory, ignore contents) ────
reports/*
!reports/.gitkeep

# ── Runtime-generated candidate / watchlist configs ──────────────────────────
# The three tracked example configs below are kept; everything the discovery
# and build-watchlist commands emit at runtime is ignored.
config/generated_crypto_*.yaml
config/generated_kalshi_*.yaml
config/clean_*.yaml
config/worldcup.yaml
config/worldcup_overrides.yaml

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
