# Public market-data endpoints do not require credentials.
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Real trading is disabled by default. Do not enable unless you are legally allowed
# to trade on Polymarket and understand that this uses real money.
POLYMARKET_LIVE_TRADING_ENABLED=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=2
POLYMARKET_CHAIN_ID=137
